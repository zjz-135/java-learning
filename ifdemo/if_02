package com.heima.practice.ifdemo;

import java.util.Scanner;

public class if_02 {
    public static void main(String[] args) {
        /*
            练习；初始最大生命200，受到x点伤害，技能回复y点血，x和y由键盘输入
            假设，游戏人物不会死亡，最少1点血
            问：最终人物血量是多少？
         */

        // 1.定义变量记录人物生命值
        int hp = 200;
        // 2.键盘输入伤害值和回复值
        System.out.println("请输入伤害值：");
        Scanner sc = new Scanner(System.in);
        int x = sc.nextInt();
        // 3.计算当前的血量
        hp = hp - x;

        // 游戏人物不会死亡，最少1点血
        if(hp <= 0){
            hp = 1;
        }
        System.out.println("当前生命值：" + hp);

        // 4.键盘输入回复值
        System.out.println("请输入回复值：");
        int y = sc.nextInt();
        // 5.计算当前血量
        hp = hp + y;
        if(hp >= 200){
            hp = 200;
        }
        System.out.println("当前生命值：" + hp);
    }
}
