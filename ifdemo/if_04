package com.heima.practice.ifdemo;

public class if_04 {
    public static void main(String[] args) {
        /*
            需求：定义一个小数表示考试成绩
            判断学生的考试成绩，如果大于60分输出通过，否则不通过
         */
        // 1.定义变量
        double score = 300;
        // 2.判断
        // 判断成绩是否合理（0-100）
        if(score >= 0 && score <= 100){
            if (score >= 60){
                System.out.println("通过");
            }else{
                System.out.println("未通过");
            }
        }else{
            System.out.println("成绩不合理,请输入正确的成绩");
        }
    }
}
