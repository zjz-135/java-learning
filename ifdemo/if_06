package com.heima.practice.ifdemo;

import java.util.Scanner;

public class if_06 {
    public static void main(String[] args) {
        /*
            卡拉兹函数
            练习：卡卡拉兹函数（Collatz function）定义如下：
            给定正整数n,
              若n为奇数，则f(n) = 3n + 1
              若n为偶数，则f(n) = n/2

            示例1：
              输入：1
              说明：奇数，3 * 1 + 1 = 4
              输出：4

            示例2：
              输入：2
              说明：偶数，2 / 2 = 1
              输出：1
         */
        // 1.定义变量
        Scanner sc = new Scanner(System.in);
        System.out.println("请输入正整数：");
        int n = sc.nextInt();
        // 2.判断
        if(n>=1){
            if(n%2==1){
                System.out.println(3*n+1);
            }else{
                System.out.println(n/2);
            }
        }else{
            System.out.println("请输入正整数");
        }
    }
}
