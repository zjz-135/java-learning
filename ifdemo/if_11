package com.heima.practice.ifdemo;

import java.util.Scanner;

public class if_11 {
    public static void main(String[] args) {
        /*
        练习：判断是否构成三角形
        键盘录入三个大于0的小数，判断这个三个数值构成什么类型的三角形？
        类型如下：
        1.普通三角形
        2.等腰三角形
        3.直角三角形
        4.等边三角形
        5.无效
        构成三角形：两边之和大于第三边

         */
        // 1.键盘录入三个数
        Scanner sc = new Scanner(System.in);
        System.out.println("请输入第一个数：");
        double a = sc.nextDouble();
        System.out.println("请输入第二个数：");
        double b = sc.nextDouble();
        System.out.println("请输入第三个数：");
        double c = sc.nextDouble();
        // 2.判断
        if(a > 0 && b > 0 && c > 0){
            if(a + b > c && a + c > b && b + c > a){
                if(a == b && b == c) System.out.println("等边三角形");
                else if(a == b || b == c || a == c) System.out.println("等腰三角形");
                else if(a * a + b * b == c * c || b * b + c * c == a * a || a * a + c * c == b * b) System.out.println("直角三角形");
                else System.out.println("普通三角形");
            }else{
                System.out.println("无效，不构成三角形");
            }
        }else{
            System.out.println("无效，请输入大于0的数");
        }
    }
}
