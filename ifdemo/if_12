package com.heima.practice.ifdemo;

import java.util.Scanner;

public class if_12 {
    public static void main(String[] args) {
        /*
        练习：直角坐标系位置判断
        规则：
            输入变量x y，判断点所在区域
            情况一：原点（x = 0 且 y = 0）
            情况二：第一象限、第二象限、第三象限、第四象限
            情况三：x轴（x = 0 且 y ！= 0）
            情况四：y轴（x ！= 0 且 y = 0）
         */
        // 1.键盘输入变量x y
        Scanner sc = new Scanner(System.in);
        System.out.println("请输入变量x：");
        int x = sc.nextInt();
        System.out.println("请输入变量y：");
        int y = sc.nextInt();
        // 2.判断
        if(x == 0 && y == 0)System.out.println("原点");
        else if(x > 0 && y > 0) System.out.println("第一象限");
        else if(x < 0 && y > 0) System.out.println("第二象限");
        else if(x < 0 && y < 0) System.out.println("第三象限");
        else if(x > 0 && y < 0) System.out.println("第四象限");
        else if(x == 0) System.out.println("x轴");
        else System.out.println("y轴");
    }
}
