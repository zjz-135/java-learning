package com.heima.practice.loopdowhile;

public class do_while_01 {
    public static void main(String[] args) {
        /*
        do...while
        do {
            // 循环体
        } while (条件);
        特点：先执行，后判断
         */

        int i = 0;
        do {
            System.out.println("i = " + i);
            i++;
        } while (i < 5);
    }
}
