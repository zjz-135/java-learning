package com.heima.practice.loopfor;

public class for_01 {
    public static void main(String[] args) {
        /*
            实现游戏中连续跳跃10次，用输出语句模拟跳跃的逻辑
            三要素
            1.初始化条件
            2.条件
            3.条件控制
            循环体：重复执行的代码
         */
        for (int i = 1; i <= 10; i++) {
            System.out.println("第" + i + "次跳跃");
        }
        System.out.println("游戏结束");
    }
}
