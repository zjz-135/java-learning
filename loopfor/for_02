package com.heima.practice.loopfor;

public class for_02 {
    public static void main(String[] args) {
      /*
      需求：使用for循环，输出1-5
      需求：使用for循环，输出5-1
       */
        for (int i = 1; i <= 5; i++) {
            System.out.println(i);
        }
        System.out.println("===================");
        for (int i = 5; i >= 1; i--) {
            System.out.println(i);
        }
    }
}
