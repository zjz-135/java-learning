package com.heima.practice.loopfor;

import java.util.Scanner;

public class for_07 {
    public static void main(String[] args) {
        /*
        数列之和
        计算以下数列前n项的和：
        S(n) = 1 - 2 + 3 - 4 + ...
         */
        Scanner sc = new Scanner(System.in);
        System.out.print("请输入n的值：");
        int n = sc.nextInt();
        int sum = 0;
        for (int i = 1; i <= n; i++) {
            if (i % 2 == 0) {
                sum -= i;
            } else {
                sum += i;
            }
        }
        System.out.println("数列前" + n + "项的和为：" + sum);
    }
}
