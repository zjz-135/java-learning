package com.heima.practice.loopwhile;

import java.util.Scanner;

public class while_04 {
    public static void main(String[] args) {
        /*
        练习：数位之和
        给定一个整数n，请计算其所有数位之和。若n为负数，请先取绝对值。
        例：
            输入:12
            说明:1+2=3
            输出:3
        例（2）：
            输入:-12
            说明:获取绝对值12，再求和1+2=3
            输出:3
         */
        Scanner sc = new Scanner(System.in);
        System.out.println("请输入一个整数：");
        int n = sc.nextInt();
        int sum = 0;

        if(n < 0) {
            n = -n;
        }

        while (n != 0) {
            sum += n % 10;
            n /= 10;
        }
        System.out.println("数位之和为：" + sum);
    }
}
