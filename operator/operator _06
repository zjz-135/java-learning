package com.heima.practice.operator;

public class operator_06 {
    public static void main(String[] args) {
        // 实现字母的大小写转换，将大写字母转化为小写字母
        // A ---> a

        // 1.定义变量记录大写的字符
        char ch = 'A';

        // 2.转换为小写---65+32--97
        char chi = (char)(ch + 32);
        System.out.println(chi);
    }
}
