package com.heima.practice.operator;

public class operator_01 {
    public static void main(String[] args) {
        /*
        算数运算符
        +   加
        -   减
        *   乘
        /   除
        %   取余
         */
        // 1.整数运算
        // 细节：整数除法，结果是整数，就是商
        // 其他运算和数学中是一样的
        int a = 10;
        int b = 3;
        System.out.println(a + b);
        System.out.println(a - b);
        System.out.println(a * b);
        System.out.println(a / b);
        System.out.println(a % b);

        System.out.println("---------------------------------");
        // 2.浮点数运算
        // 细节：小数直接参与计算，结果有可能不精确的
        double c = 10.0;
        double d = 3.0;
        System.out.println(c + d);
        System.out.println(c - d);
        System.out.println(c * d);
        System.out.println(c / d);
        System.out.println(c % d);
    }
}
