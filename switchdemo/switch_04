        /*
        练习：
        根据用户输入的月份，输出季节
        1-2-3 ：春
        4-5-6 ：夏
        7-8-9 ：秋
        10-11-12 ：冬
         */
        // 1.键盘录入月份
        Scanner sc = new Scanner(System.in);
        System.out.println("请输入月份：");
        int month = sc.nextInt();
        // 2。判断
        switch (month){
            case 1:
            case 2:
            case 3:
                System.out.println("春");
                break;
            case 4:
            case 5:
            case 6:
                System.out.println("夏");
                break;
            case 7:
            case 8:
            case 9:
                System.out.println("秋");
                break;
            case 10:
            case 11:
            case 12:
                System.out.println("冬");
                break;
            default:
                System.out.println("没有匹配到");
                break;
        }
    }
}
